{
  "schema_version": 1,
  "_comment": "Provider 元数据配置（替代 model_router.py / config.py 中的硬编码默认值）",
  "_doc": "所有默认值均来自各 provider 官方文档，标注 doc_url + doc_note 以便溯源。用户可通过此文件直接编辑，或通过环境变量覆盖（环境变量优先级最高）。",
  "_env_override": {
    "AGNES_MAX_TOKENS_CAP": "覆盖 agnes.max_tokens_cap",
    "MIMO_MAX_TOKENS_CAP": "覆盖 mimo.max_tokens_cap",
    "OLLAMA_MAX_TOKENS_CAP": "覆盖 ollama.max_tokens_cap（0=不裁剪）",
    "AGNES_BASE_URL": "覆盖 agnes.base_url_default",
    "MIMO_BASE_URL": "覆盖 mimo.base_url_default",
    "DEEPSEEK_BASE_URL": "覆盖 deepseek.base_url_default"
  },
  "providers": {
    "agnes": {
      "protocol": "openai_compatible",
      "environment_aliases": ["AGNES_API_KEY"],
      "base_url_default": "https://apihub.agnes-ai.cn/v1",
      "max_tokens_cap": 65535,
      "default_model": "agnes-2.0-flash",
      "doc_url": "https://docs.agnes-ai.cn/",
      "doc_note": "agnes-2.0-flash 官方 max_tokens 上限 65536（2026-07 官方文档确认；超过返回 500 InternalServerError 'max_tokens exceeds the limit of 65536'）。配置取 65535（=上限-1）作为安全裁剪阈值，避免边界值因 SDK/服务端差异偶发 500。",
      "supports_vision": false,
      "supports_tools": true,
      "builtin": true
    },
    "mimo": {
      "protocol": "openai_compatible",
      "environment_aliases": ["MIMO_API_KEY"],
      "base_url_default": "https://api.xiaomimimo.com/v1",
      "max_tokens_cap": 131072,
      "default_model": "mimo-v2.5",
      "default_pro_model": "mimo-v2.5-pro",
      "doc_url": "https://platform.xiaomimimo.com?ref=SU5WDZ",
      "doc_note": "mimo-v2.5 官方 max_tokens 上限 131072；当前仅 mimo-v2.5 支持图片理解（Base64 编码传入）。default_pro_model 为思考增强变体 mimo-v2.5-pro。",
      "supports_vision": true,
      "supports_tools": true,
      "builtin": true
    },
    "deepseek": {
      "protocol": "openai_compatible",
      "environment_aliases": ["DEEPSEEK_API_KEY"],
      "base_url_default": "https://api.deepseek.com/v1",
      "max_tokens_cap": 8192,
      "default_model": "deepseek-chat",
      "doc_url": "https://platform.deepseek.com/",
      "doc_note": "deepseek-chat 官方 max_output_tokens 上限 8192（2026-07 官方文档）",
      "supports_vision": false,
      "supports_tools": true
    },
    "siliconflow": {
      "protocol": "openai_compatible",
      "environment_aliases": ["SILICONFLOW_API_KEY"],
      "base_url_default": "https://api.siliconflow.cn/v1",
      "max_tokens_cap": null,
      "default_model": "deepseek-ai/DeepSeek-V3-0324",
      "doc_url": "https://siliconflow.cn/",
      "doc_note": "硅基流动聚合平台，max_tokens 上限视具体模型而定，默认不裁剪",
      "supports_vision": false,
      "supports_tools": true
    },
    "openrouter": {
      "protocol": "openai_compatible",
      "environment_aliases": ["OPENROUTER_API_KEY"],
      "base_url_default": "https://openrouter.ai/api/v1",
      "max_tokens_cap": null,
      "default_model": "",
      "doc_url": "https://openrouter.ai/docs",
      "doc_note": "OpenRouter 聚合平台，max_tokens 上限视具体模型而定，默认不裁剪",
      "supports_vision": false,
      "supports_tools": true
    },
    "modelscope": {
      "protocol": "openai_compatible",
      "environment_aliases": ["MODELSCOPE_ACCESS_TOKEN", "MODELSCOPE_API_KEY"],
      "base_url_default": "https://api-inference.modelscope.cn/v1/",
      "max_tokens_cap": null,
      "default_model": "",
      "doc_url": "https://modelscope.cn/",
      "doc_note": "魔搭社区聚合平台，max_tokens 上限视具体模型而定，默认不裁剪",
      "supports_vision": false,
      "supports_tools": true
    },
    "ollama": {
      "protocol": "ollama",
      "environment_aliases": ["OLLAMA_API_KEY"],
      "base_url_default": "",
      "max_tokens_cap": null,
      "default_model": "qwen2.5:latest",
      "model_name_map": {
        "_comment": "工作流/云平台(如硅基流动)写死的模型名 → 本地 Ollama 实际模型名 的映射。请求模型名精确命中时使用映射值；含 / 的云模型名(如 deepseek-ai/DeepSeek-V3-0324)会自动回退到 default_model。请按你本地 pull 的实际模型名修改。也可用环境变量 OLLAMA_MODEL_MAP(JSON)/OLLAMA_DEFAULT_MODEL 覆盖",
        "deepseek-ai/DeepSeek-V3-0324": "qwen2.5:latest",
        "deepseek-chat": "qwen2.5:latest"
      },
      "doc_url": "https://ollama.com/",
      "doc_note": "Ollama 本地部署，无固定上限（视本地模型而定）。模型名映射机制：路由把工作流/云模型名翻译为本地模型名后再真实转发给本地 Ollama（OLLAMA_BASE_URL，如 http://localhost:11434/v1），避免 model not found。default_model 是云模型名（含 / 的 org/model 名）回退到的本地模型。仅当 OLLAMA_BASE_URL 环境变量显式配置时才启用，不默认注册",
      "supports_vision": false,
      "supports_tools": true
    },
    "llama.cpp": {
      "protocol": "openai_compatible",
      "environment_aliases": ["LLAMA_CPP_API_KEY"],
      "base_url_default": "",
      "max_tokens_cap": null,
      "default_model": "",
      "doc_url": "https://github.com/ggml-org/llama.cpp",
      "doc_note": "本地 llama.cpp server（OpenAI 兼容接口，无需 API Key）。仅当 LLAMA_CPP_BASE_URL 环境变量显式配置时才启用，不默认注册；有配置就用，没有就不启用。",
      "supports_vision": false,
      "supports_tools": true
    }
  },
  "_cross_provider_fallback": {
    "_comment": "主 provider 故障时的跨 provider 兜底映射（替代 model_router.py 中硬编码的 _CROSS_PROVIDER_MAP）",
    "agnes": {"fallback_provider": "mimo", "fallback_model": "mimo-v2.5"},
    "mimo": {"fallback_provider": "agnes", "fallback_model": "agnes-2.0-flash"},
    "ollama": {"fallback_provider": "mimo", "fallback_model": "mimo-v2.5"}
  }
}
