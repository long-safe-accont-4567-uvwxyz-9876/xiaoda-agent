#!/bin/bash
# =============================================================================
# pre-push 测试门禁（2026-08-22 技术债批）
# 背景：仓库托管在 Gitee，.github/workflows/*.yml 不会被任何 CI 执行——
#       本地门禁是当前唯一的自动化测试防线。
# 用法：
#   正常推送        → 自动跑 critical 子集（19 文件，约 20 秒）
#   跑全集再推      → PUSH_FULL_TESTS=1 git push（约 5 分钟）
#   跳过检查        → git push --no-verify（紧急通道，用后请补跑）
# 启用方式（每个 clone 一次）：
#   git config core.hooksPath scripts/git-hooks
# =============================================================================
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# 无待推送内容（远端分支删除/空输入等）→ 静默放行
ZERO_OID="0000000000000000000000000000000000000000"
PUSHED_ANY=0
while read -r _local_ref local_oid _remote_ref _remote_oid; do
    [ -n "$local_oid" ] || continue
    if [ "$local_oid" != "$ZERO_OID" ]; then
        PUSHED_ANY=1
    fi
done
[ "$PUSHED_ANY" = "1" ] || exit 0

PYTHON="$PWD/.venv/bin/python"
# 必须用 venv：系统 python3 会混载 dist-packages 的旧 Pillow(9.4) 等原生库，全量跑会段错误
if [ ! -x "$PYTHON" ]; then
    echo "[pre-push] 错误：找不到 $PWD/.venv/bin/python（不要用系统 python3 跑测试，旧 PIL/依赖混载会 segfault）" >&2
    exit 1
fi

# ── 前端构建物新鲜度（廉价检查，毫秒级；完整重建校验见 scripts/check_dist_freshness.sh）
# 改了 web/frontend 源码却没重新 build + 提交 web/dist → FastAPI 会静默服务旧 UI。
# 判据：源码最后一次提交晚于 dist 最后一次提交即为失同步嫌疑。
FRONTEND_LAST=$(git log -1 --format=%ct -- web/frontend 2>/dev/null || true)
DIST_LAST=$(git log -1 --format=%ct -- web/dist 2>/dev/null || true)
if [ -n "$FRONTEND_LAST" ] && [ -n "$DIST_LAST" ] && [ "$FRONTEND_LAST" -gt "$DIST_LAST" ]; then
    # 时间戳只是"嫌疑"判据——内容级零 diff 时（如提交拆分导致 src 提交晚于
    # 内容相同的 dist 提交）回退到权威内容校验，避免误报拦截（2026-08-23 修复：
    # 分主题提交批次被时间戳误拦，check_dist_freshness.sh 实际同步）。
    echo "[pre-push] 源码提交晚于 dist，运行完整内容校验..." >&2
    if bash "$PWD/scripts/check_dist_freshness.sh"; then
        echo "[pre-push] 内容校验通过（dist 与源码实际同步），继续" >&2
    else
        echo "[pre-push] 错误：web/dist 确实落后于源码——请 cd web/frontend && npm run build && git add web/dist && git commit" >&2
        exit 1
    fi
fi

# ── 宽口径 except 棘轮（毫秒级）：存量 1136 冻结，增量拦截（技术债专项 #2）
bash "$PWD/scripts/check_broad_except.sh"

# ── 函数内延迟 import 棘轮（秒级）：存量冻结，增量拦截（技术债 P1-3 专项）
"$PYTHON" "$PWD/scripts/check_lazy_imports.py"

# ── i18n 双字典 key 一致性（秒级；review 补漏——原只接了不运行的 GH workflow）
if [ -d "$PWD/web/frontend/node_modules" ]; then
    (cd "$PWD/web/frontend" && npm run --silent check:i18n) || {
        echo "[pre-push] ✗ i18n key 不一致，推送被拦（npm run check:i18n 查看明细）" >&2
        exit 1
    }
fi

if [ "${PUSH_FULL_TESTS:-0}" = "1" ]; then
    echo "[pre-push] 全集测试门禁（约 5 分钟，--no-verify 可跳过）..."
    # 不用 exec：测试全绿后还要跑构建物新鲜度校验
    "$PYTHON" -m pytest tests/ -q --timeout=60 \
        -m "not slow and not e2e_real" \
        --deselect "tests/test_a4_rag_root_fix.py::TestIntentClassifyDefault::test_intent_llm_classify_default_false"
    bash "$PWD/scripts/check_dist_freshness.sh"
fi

# critical 子集单一事实源：scripts/critical_tests.txt（与两份 workflow 共用）
CRITICAL_LIST="$PWD/scripts/critical_tests.txt"
if [ ! -f "$CRITICAL_LIST" ]; then
    echo "[pre-push] FATAL: $CRITICAL_LIST 不存在——门禁清单被误删，拒绝推送" >&2
    exit 1
fi
# 清单内文件必须真实存在（防止删测试后清单腐烂）
while IFS= read -r _t; do
    case "$_t" in ''|'#'*) continue ;; esac
    if [ ! -f "$PWD/$_t" ]; then
        echo "[pre-push] FATAL: critical 清单引用了不存在的 $_t ——请更新 scripts/critical_tests.txt" >&2
        exit 1
    fi
done < "$CRITICAL_LIST"

# ── requirements.lock ↔ requirements.txt 一致性（技术债 P0-1 复发防线）──
# lock 的每个 == 精确版本必须满足 txt 的范围约束；lock 缺 txt 声明的包也拦。
"$PYTHON" - <<'PYEOF' || exit 1
import re, sys

def declared(path):
    out = {}
    for raw in open(path, encoding="utf-8"):
        line = re.sub(r"#.*", "", raw).strip()
        if not line:
            continue
        m = re.match(r"^([A-Za-z0-9][A-Za-z0-9._-]*)([^;#]*)", line)
        if not m or not m.group(2).strip():
            continue  # 无版本约束的声明不校验
        # 平台专属依赖（如 pywinpty; sys_platform == "win32"）不适用本 Linux 锁文件
        marker = raw.split(";", 1)[1] if ";" in raw else ""
        if "win32" in marker or "Windows" in marker:
            continue
        out[m.group(1).lower().replace("_", "-")] = m.group(2).strip()
    return out

def vt(s):
    return [int(x) for x in s.split(".") if x.isdigit()]

txt = declared("requirements.txt")
lock = declared("requirements.lock")
bad = []
for name, spec in txt.items():
    pin = lock.get(name)
    if pin is None:
        bad.append(f"lock 缺少 txt 声明: {name} ({spec})")
        continue
    m_lo = re.match(r"^>=\s*([\d.]+)", spec)
    m_pin = re.match(r"^==\s*([\d.]+)", pin)
    hi = re.search(r"<\s*([\d.]+)", spec)
    if m_lo and m_pin and vt(m_pin.group(1)) < vt(m_lo.group(1)):
        bad.append(f"{name}: lock {pin} 低于 txt 下限 {spec}")
    if hi and m_pin and vt(m_pin.group(1)) >= vt(hi.group(1)):
        bad.append(f"{name}: lock {pin} 达到/超过 txt 上界 {spec}")
if bad:
    print("[pre-push] requirements.lock 与 requirements.txt 漂移：", file=sys.stderr)
    for b in bad:
        print(f"  - {b}", file=sys.stderr)
    sys.exit(1)
print("[pre-push] lock↔txt 一致性 OK")
PYEOF

echo "[pre-push] critical 子集门禁（来源 scripts/critical_tests.txt，--no-verify 可跳过）..."
exec "$PYTHON" -m pytest $(grep -vE '^\s*(#|$)' "$CRITICAL_LIST") \
    -q --timeout=60
