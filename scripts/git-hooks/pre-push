#!/bin/bash
# =============================================================================
# pre-push 测试门禁（2026-08-22 技术债批）
# 背景：仓库托管在 Gitee，.github/workflows/*.yml 不会被任何 CI 执行——
#       本地门禁是当前唯一的自动化测试防线。
# 用法：
#   正常推送        → 自动跑 critical 子集（18 文件，约 20 秒）
#   跑全集再推      → PUSH_FULL_TESTS=1 git push（约 5 分钟）
#   跳过检查        → git push --no-verify（紧急通道，用后请补跑）
# 启用方式（每个 clone 一次）：
#   git config core.hooksPath scripts/git-hooks
# =============================================================================
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

# 无待推送内容（远端分支删除/空输入等）→ 静默放行
ZERO_OID="0000000000000000000000000000000000000000"
PUSHED_ANY=0
while read -r _local_ref local_oid _remote_ref _remote_oid; do
    [ -n "$local_oid" ] || continue
    if [ "$local_oid" != "$ZERO_OID" ]; then
        PUSHED_ANY=1
    fi
done
[ "$PUSHED_ANY" = "1" ] || exit 0

PYTHON="$PWD/.venv/bin/python"
[ -x "$PYTHON" ] || PYTHON="$(command -v python3)"

if [ "${PUSH_FULL_TESTS:-0}" = "1" ]; then
    echo "[pre-push] 全集测试门禁（约 5 分钟，--no-verify 可跳过）..."
    exec "$PYTHON" -m pytest tests/ -q --timeout=60 \
        -m "not slow and not e2e_real" \
        --deselect "tests/test_a4_rag_root_fix.py::TestIntentClassifyDefault::test_intent_llm_classify_default_false"
fi

echo "[pre-push] critical 子集门禁（18 文件，--no-verify 可跳过）..."
exec "$PYTHON" -m pytest \
    tests/test_smoke.py \
    tests/test_agent_routing.py \
    tests/test_context_compressor.py \
    tests/test_risk_classifier.py \
    tests/test_error_classifier.py \
    tests/test_model_route_validation.py \
    tests/test_matrix_governance.py \
    tests/test_prompt_integration.py \
    tests/test_cognitive_memory.py \
    tests/test_hopfield_layer.py \
    tests/test_ssrf_guard.py \
    tests/test_tool_guardrails.py \
    tests/test_credential_pool.py \
    tests/test_credential_vault.py \
    tests/test_cancel_token.py \
    tests/test_event_bus.py \
    tests/test_shared_blackboard.py \
    tests/test_circuit_breaker.py \
    -q --timeout=60
